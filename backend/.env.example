# Environment
NODE_ENV=development
PORT=5000

# MongoDB
MONGO_URI=mongodb://localhost:27017/workpulse
MONGO_URI_TEST=mongodb://localhost:27017/workpulse_test

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# CORS
CLIENT_URL=http://localhost:3000
APP_PUBLIC_URL=http://localhost:3000

# Voice Service
VOICE_SERVICE_URL=http://localhost:8000

# Payments & Escrow (Phase 5)
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYOUT_PROVIDER=mock
PAYOUT_MOCK_FAIL_RATE=0
PLATFORM_FEE_PERCENT=0
ESCROW_SCHEDULER_INTERVAL_SEC=60
ESCROW_AUTO_APPROVAL_OVERRIDE_SEC=
MIN_TOPUP_PAISE=10000
MAX_TOPUP_PAISE=5000000
MIN_WITHDRAW_PAISE=10000
DEV_ALLOW_MOCK_TOPUP=true

# SMS Gateway (Phase 3)
SMS_PROVIDER=mock
SMS_FALLBACK_DELAY_SEC=15
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Matching & Notification Settings
MAX_WORKERS_NOTIFIED_PER_JOB=50

# Seed Center Location (Pune default)
SEED_CENTER_LAT=18.5204
SEED_CENTER_LNG=73.8567

# Dev Mode Flags
OTP_DEV_MODE=true

# Attendance & Proof-of-Work (Phase 4)
ATTENDANCE_REQUIRE_FUNDING=true
ATTENDANCE_MAX_ACCURACY_M=50
ATTENDANCE_MAX_CLOCK_DRIFT_SEC=120
ATTENDANCE_EARLY_CHECKIN_MIN=30
ATTENDANCE_LATE_GRACE_MIN=60
ATTENDANCE_MAX_SPEED_KMH=150
SELFIE_MAX_BYTES=2097152
ATTENDANCE_SCHEDULER_INTERVAL_SEC=60
DEV_ALLOW_LOCATION_OVERRIDE=true

# Voice Onboarding (Phase 6)
VOICE_ENABLED=true
VOICE_SERVICE_URL=http://localhost:8000
VOICE_SERVICE_API_KEY=workpulse-internal-voice-key-2026
VOICE_TIMEOUT_MS=30000
VOICE_MAX_AUDIO_BYTES=5242880
VOICE_ONBOARD_RATE_PER_HOUR=10
VOICE_EXTRACT_RATE_PER_HOUR=30
VOICE_SESSION_TTL_DAYS=90
VOICE_DEGRADED_COOLDOWN_SEC=60
VOICE_CONSENT_VERSION=v1
